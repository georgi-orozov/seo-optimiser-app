# PostgreSQL password — change this before running
POSTGRES_PASSWORD=changeme

# Anthropic Claude API key — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-...

# Clerk Frontend API URL — found in Clerk dashboard under API Keys > Frontend API URL
# Example: https://your-app.clerk.accounts.dev
CLERK_AUTHORITY=https://your-app.clerk.accounts.dev

# Frontend origin (for CORS) — defaults to Vite dev server if not set
FRONTEND_URL=http://localhost:5173

# Skip JWT validation — injects a synthetic "dev-user-bypass" user instead.
# Set to true ONLY for local debugging. Never set in production.
# Maps to appsettings key Auth:Bypass
AUTH__BYPASS=false
